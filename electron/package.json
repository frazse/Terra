{
  "name": "terra-desktop",
  "version": "0.11.2",
  "description": "Terra Desktop - Biketerra Companion App (Chromium)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --linux appimage",
    "dist:win": "electron-builder --win"
  },
  "author": "frazse",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.frazse.terra",
    "productName": "Terra",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "../target/release",
        "to": "bin",
        "filter": [
          "terra",
          "terra.exe"
        ]
      },
      {
        "from": "../shim",
        "to": "shim"
      }
    ],
    "files": [
      "main.js",
      "preload.js"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "../icons/icon.png",
      "category": "Sports"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@44.9.3": true
  }
}
